{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "clean-debug",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-Command",
                "if (Test-Path 'Debug') { Remove-Item 'Debug\\*' -Recurse -Force }"
            ]
        },
        {
            "label": "make-debug-folder",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-Command",
                "if (!(Test-Path 'Debug')) { New-Item -ItemType Directory -Path 'Debug' }"
            ]
        },

        {
            "label": "ArchSim FOC Build Tools",
            "type": "shell",
            "command": "D:\\Tools\\MinGW64\\bin\\gcc.exe",
            "args": [
                "-Wall",
                "-g",
                "-O0",
                "-std=c99",

                "sim/sim_main.c",
                "sim/pmsm_rk4.c",
                "sim/inverter_model.c",
                "sim/speed_controller.c",

                "mc/api/mc.c",
                "mc/features/hard_brake.c",
                "mc/features/torq_compensation.c",
                "mc/foc/foc.c",
                "mc/fs/fs.c",
                "mc/fs/fsglobals.c",
                "mc/init/mcinit.c",
                "mc/loops/mcloop.c",
                "mc/observers/mcobservers.c",
                "mc/sampling/mcsampling.c",
                "mc/states/mcstate.c",
                "mc/test/mctest.c",
                "mc/uti/controllers.c",
                "mc/uti/dsp.c",
                "mc/uti/math_.c",
                "mc/vp/mcglobals.c",

                "brd/brd.c",

                "-I", "sim",
                "-I", "mc",
                "-I", "mc/api",
                "-I", "mc/features",
                "-I", "mc/foc",
                "-I", "mc/fs",
                "-I", "mc/init",
                "-I", "mc/loops",
                "-I", "mc/observers",
                "-I", "mc/sampling",
                "-I", "mc/states",
                "-I", "mc/test",
                "-I", "mc/uti",
                "-I", "mc/vp",
                "-I", "brd",
                "-I", "Parameters/Motors",
                "-I", "Parameters/Boards",

                "-o", "Debug/SimArch_foc.exe",
                "-lm"
            ],
            "dependsOn": ["clean-debug", "make-debug-folder"],
            "group": "build",
            "problemMatcher": ["$gcc"]
        },

        {
            "label": "Run Simulation",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-Command",
                "& \"${workspaceFolder}/Debug/SimArch_foc.exe\""
            ],
            "options": {
                "cwd": "${workspaceFolder}/Debug"
            }
        },

        {
            "label": "Run Python Plot",
            "type": "shell",
            "command": "D:\\Tools\\WPy64\\python\\python.exe",
            "args": [
                "-u",
                "plot_sim.py",
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },

        {
            "label": "Build + Run + Plot",
            "group": "build",
            "dependsOn": [
                "ArchSim FOC Build Tools",
                "Run Simulation",
                "Run Python Plot"
            ],
            "dependsOrder": "sequence"
        },

        {
            "label": "Only Plot",
            "group": "build",
            "dependsOn": [
                "Run Python Plot"
            ],
            "dependsOrder": "sequence"
        }
    ]
}